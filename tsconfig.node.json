{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "isolatedModules": true,
    "types": ["node"],
    "outDir": "node-build",
    "rootDir": "."
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
